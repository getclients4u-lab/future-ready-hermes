{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://futureready.dev/schemas/user.json",
  "title": "User",
  "type": "object",
  "required": ["email", "password"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 255
    },
    "full_name": {
      "type": "string",
      "maxLength": 255
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "role": {
      "type": "string",
      "enum": ["user", "admin", "superuser"],
      "default": "user"
    },
    "avatar_url": {
      "type": "string",
      "format": "uri"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://futureready.dev/schemas/project.json",
  "title": "Project",
  "type": "object",
  "required": ["name", "owner_id"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "status": {
      "type": "string",
      "enum": ["draft", "in_progress", "review", "completed", "archived"],
      "default": "draft"
    },
    "spec": {
      "type": "object",
      "properties": {
        "user_stories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "feature", "benefit", "priority"],
            "properties": {
              "role": { "type": "string" },
              "feature": { "type": "string" },
              "benefit": { "type": "string" },
              "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
              "acceptance_criteria": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "tech_stack": {
          "type": "object",
          "properties": {
            "frontend": { "type": "string" },
            "backend": { "type": "string" },
            "database": { "type": "string" },
            "deployment": { "type": "string" }
          }
        },
        "api_contract": {
          "type": "object",
          "description": "OpenAPI 3.0 specification object"
        }
      }
    },
    "owner_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
